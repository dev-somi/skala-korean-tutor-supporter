# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git에 올리지 않는다)
# backend(Spring)와 ai-server(FastAPI)가 같은 키 이름을 쓴다.

# --- LLM (ADR-0007) ---
ANTHROPIC_API_KEY=
# (선택) API Gateway를 거치는 경우에만
# ANTHROPIC_BASE_URL=
# ai-server는 "제공자:모델이름", Spring AI는 모델 이름만 읽는다
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=anthropic:claude-haiku-5-5
LLM_MODEL_QUALITY=anthropic:claude-sonnet-5-5

# --- (선택) 로컬 Ollama로 개발하기 (ADR-0012): API 토큰을 쓰지 않는다 ---
# 위 세 줄을 지우고 아래 주석을 푼다. 먼저 bash scripts/setup_ollama.sh
# LLM_PROVIDER=ollama
# LLM_MODEL_FAST=ollama:qwen3:8b
# LLM_MODEL_QUALITY=ollama:qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384

# --- Postgres (docker-compose.yml, ADR-0002) ---
POSTGRES_DB=tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
DB_URL=jdbc:postgresql://localhost:5432/tutor

# --- 서비스 주소 ---
AI_SERVER_URL=http://localhost:8000

# --- (선택) LangSmith trace: ai-server의 그래프·LLM·검색 실행을 기록한다 (기술 ADR-0028) ---
# 켜면 앱의 "AI 추적" 탭에서 실행 트리를 볼 수 있다. 키: https://smith.langchain.com → Settings → API Keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=korean-tutor-dev

# --- (선택) 출처 "원문" 버튼이 원본 PDF를 여는 앱 (기술 ADR-0030). 기본 Google Chrome. 쪽 이동은 Chromium 계열만 된다 ---
# PDF_VIEWER=Google Chrome
